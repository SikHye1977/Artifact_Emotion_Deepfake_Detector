# Publish only model, experiment, loader and required helper code.
/*
!/.gitignore
!/src/
!/scripts/

/src/*
!/src/__init__.py
!/src/models/
!/src/datasets/
!/src/utils/
!/src/evaluation/

/src/evaluation/*
!/src/evaluation/__init__.py
!/src/evaluation/evaluate.py
!/src/evaluation/metrics.py

/scripts/*
!/scripts/reproduce_x3a/

# Generated files never belong in the code-only repository.
__pycache__/
*.py[cod]
*.log
*.pt
*.pth
*.pyth
.env

# Shared runtime configuration required after cloning
!/QUICKSTART.md
!/requirements.txt
!/configs/
/configs/*
!/configs/local_paths.example.yaml
!/configs/fixed_manifests.json
!/configs/phase0_data_quality_v1.json
!/configs/third_party.lock.json
!/configs/experiments/
/configs/experiments/*
!/configs/experiments/x3a_reproduction/
/configs/experiments/x3a_reproduction/*
!/configs/experiments/x3a_reproduction/fav_indomain_v1/
/configs/experiments/x3a_reproduction/fav_indomain_v1/*
!/configs/experiments/x3a_reproduction/fav_indomain_v1/x3d_4gpu.yaml
!/configs/experiments/x3a_reproduction/fav_indomain_v1/aasist_4gpu.yaml
!/configs/experiments/x3a_reproduction/fav_indomain_v1/x3d_single_gpu.yaml
!/configs/experiments/x3a_reproduction/fav_indomain_v1/aasist_single_gpu.yaml
